# M-8：生產環境請使用 app_user（非 superuser）連線。
# 若使用 docker-compose，APP_DB_PASSWORD 需與 docker-compose.yml 中 APP_DB_PASSWORD 一致。
DATABASE_URL=postgresql://app_user:changeme_in_production@localhost:5432/disaster_report
# 本機開發（未套用 init-db.sql）仍可用 postgres superuser：
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disaster_report
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Anthropic base URL; leave empty to use Anthropic official endpoint
ANTHROPIC_BASE_URL=https://api.banana2556.com
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Dedup 專用模型（需較強推理能力做語意比對）
DEDUP_MODEL=claude-sonnet-4-6

# JWT 簽章密鑰（必填）：長度至少 32 字元，不可使用 placeholder。
# 請用 `openssl rand -hex 32` 產生 64 字元 hex 字串，或等效強隨機值。
# 若缺少或為弱值，啟動會因 pydantic 驗證失敗而中止。
JWT_SECRET_KEY=

# M-7：生產環境啟用 DB SSL（docker-compose / 公網 PostgreSQL 必須設 True）
DB_REQUIRE_SSL=False

# M-8：docker-compose app_user 密碼（與 docker-compose.yml APP_DB_PASSWORD 一致）
APP_DB_PASSWORD=changeme_in_production
